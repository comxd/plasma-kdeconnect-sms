msgstr "-- Пристрої не знайдено --"

#: contents/ui/configGeneral.qml
msgid "-- Select a country --"
msgstr "-- Виберіть країну --"

#: contents/ui/configGeneral.qml
msgid "Device:"
msgstr "Пристрій:"


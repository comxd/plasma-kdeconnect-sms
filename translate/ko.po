msgstr "SMS 기록"

#: contents/ui/main.qml
msgid "Hide widget from panel"
msgstr "패널에서 위젯 숨기기"

#: contents/ui/main.qml
msgid "About KDE Connect SMS"
msgstr "KDE Connect SMS 정보"

#: contents/ui/main.qml
msgid "Help && FAQ"
msgstr "도움말 및 FAQ"

